        goto cycles;
    }

    /* approach: every replica enters its own window */
#ifdef _OPENMP
#pragma omp parallel for schedule(dynamic, 1)
#endif
    for (i = 0; i < W; i++)
        res->approach[i] = approach(&rep[i], &d, ws[i], wg[i], res->Kmin[i], res->Kmax[i],
