#include "reus.h"
#include "rng.h"
#include "tps.h"

#include <math.h>
#include <signal.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <time.h>

#ifdef _OPENMP
#include <omp.h>
#endif

typedef struct {
    Traj tr;
    Shot sh;
    Rng rng;
    int win;  /* current window */
    int trip; /* 0: not yet at window 0, 1: left window 0, 2: reached the top since then */
} Replica;

void reus_default_params(REUSParams *p)
{
    memset(p, 0, sizeof(*p));
    p->L = 100;
    p->T = 1.0;
    p->tobs = 600;
    p->nwin = 22;
    p->k_lo = 0.0;
    p->k_hi = 0.08;
    p->n_approach = 1000000;
    p->n_equil = 20000;
    p->n_prod = 1000000;
    p->swap_every = 10;
    p->sample_every = 10;
    p->init = "empty";
    p->checkpoint = NULL;
    p->checkpoint_every = 1800.0;
    p->stop_after = 0.0;
    p->stop_cycle = 0;
}

void reus_window(const REUSParams *p, int w, long *Kmin, long *Kmax)
{
    const double LT = (double)p->L * p->tobs;
    const double D = (p->k_hi - p->k_lo) / (p->nwin + 1);
    long a = (long)ceil((p->k_lo + w * D) * LT - 1e-9);
    long b = (long)floor((p->k_lo + (w + 2) * D) * LT + 1e-9);
    if (a < 0) a = 0;
    if (b > (long)LT) b = (long)LT;
    *Kmin = a;
    *Kmax = b;
}

static int file_exists(const char *path)
{
    FILE *f = fopen(path, "r");
    if (!f) return 0;
    fclose(f);
    return 1;
}

static int init_replica(const REUSParams *p, const Dyn *d, Replica *r, int i, int *from_file)
{
    *from_file = 0;
    if (traj_alloc(&r->tr, p->L, p->tobs) != 0 || shot_alloc(&r->sh, p->L, p->tobs) != 0)
        return -1;
    if (!strcmp(p->init, "empty")) {
        traj_recount(&r->tr);
    } else if (!strcmp(p->init, "equilibrium")) {
        traj_init_equilibrium(&r->tr, d, &r->rng);
    } else {
        char path[1024];
        const char *pc = strchr(p->init, '%');
        if (!pc) {
            snprintf(path, sizeof(path), "%s", p->init); /* one file for every window */
        } else {
            /* exactly one conversion of the form %d or %0Nd */
            const char *q = pc + 1;
            while (*q >= '0' && *q <= '9') q++;
            if (*q != 'd' || strchr(q + 1, '%')) {
                fprintf(stderr, "error: init pattern '%s' must contain one %%d (e.g. w%%02d.traj)\n",
                        p->init);
                return -1;
            }
            snprintf(path, sizeof(path), p->init, i);
        }
        if (file_exists(path) && traj_load(&r->tr, path) == 0) {
            *from_file = 1;
        } else {
            fprintf(stderr, "note: window %d: no usable trajectory '%s', starting empty\n", i,
                    path);
            memset(r->tr.x, 0, (size_t)(p->tobs + 1) * (size_t)p->L);
            memset(r->tr.k, 0, sizeof(int) * (size_t)(p->tobs + 1));
            traj_recount(&r->tr);
        }
    }
    return 0;
}

/* ---- stop requests and checkpoints ---- */

static volatile sig_atomic_t stop_requested = 0;

static void on_stop_signal(int sig)
{
    (void)sig;
    stop_requested = 1;
}

typedef struct {
    char magic[8];
    int L, tobs, nwin, swap_every, sample_every;
    double T, eps, s, g, k_lo, k_hi;
    long n_equil, n_prod, nsamp;
} CkHeader;

static void ck_header(const REUSParams *p, long nsamp, CkHeader *h)
{
    memset(h, 0, sizeof(*h)); /* also clears the padding written to the file */
    memcpy(h->magic, "SEREUS01", 8);
    h->L = p->L;
    h->tobs = p->tobs;
    h->nwin = p->nwin;
    h->swap_every = p->swap_every;
    h->sample_every = p->sample_every;
    h->T = p->T;
    h->eps = p->eps;
    h->s = p->s;
    h->g = p->g;
    h->k_lo = p->k_lo;
    h->k_hi = p->k_hi;
    h->n_equil = p->n_equil;
    h->n_prod = p->n_prod;
    h->nsamp = nsamp;
}

static int ck_io(FILE *f, void *buf, size_t size, size_t n, int writing)
{
    if (n == 0) return 0;
    return (writing ? fwrite(buf, size, n, f) : fread(buf, size, n, f)) == n ? 0 : -1;
}

/* State after c_next cycles: header, seed, master rng, replicas, counters, samples. */
static int ck_body(FILE *f, int writing, const CkHeader *h, REUSResult *res, Replica *rep,
                   int *rep_of_win, Rng *master, long *c_next, long *nfilled)
{
    const int W = h->nwin;
    const size_t xs = (size_t)(h->tobs + 1) * (size_t)h->L, ts = (size_t)(h->tobs + 1);
    int i, err = 0;
    err |= ck_io(f, &res->seed_used, sizeof(uint64_t), 1, writing);
    err |= ck_io(f, master, sizeof(Rng), 1, writing);
    err |= ck_io(f, c_next, sizeof(long), 1, writing);
    err |= ck_io(f, nfilled, sizeof(long), 1, writing);
    if (err || *nfilled < 0 || *nfilled > res->nsamp) return -1;
    for (i = 0; i < W; i++) {
        Replica *r = &rep[i];
        err |= ck_io(f, &r->rng, sizeof(Rng), 1, writing);
        err |= ck_io(f, &r->win, sizeof(int), 1, writing);
        err |= ck_io(f, &r->trip, sizeof(int), 1, writing);
        err |= ck_io(f, &r->tr.K, sizeof(long), 1, writing);
        err |= ck_io(f, &r->tr.E, sizeof(long), 1, writing);
        err |= ck_io(f, r->tr.x, 1, xs, writing);
        err |= ck_io(f, r->tr.n, sizeof(int), ts, writing);
        err |= ck_io(f, r->tr.k, sizeof(int), ts, writing);
    }
    err |= ck_io(f, rep_of_win, sizeof(int), (size_t)W, writing);
    err |= ck_io(f, res->moves, sizeof(long), (size_t)W, writing);
    err |= ck_io(f, res->acc, sizeof(long), (size_t)W, writing);
    err |= ck_io(f, res->swap_try, sizeof(long), (size_t)W, writing);
    err |= ck_io(f, res->swap_acc, sizeof(long), (size_t)W, writing);
    err |= ck_io(f, res->round_trips, sizeof(long), (size_t)W, writing);
    err |= ck_io(f, res->approach, sizeof(long), (size_t)W, writing);
    err |= ck_io(f, res->init_from_file, sizeof(int), (size_t)W, writing);
    err |= ck_io(f, res->seeded_from, sizeof(int), (size_t)W, writing);
    for (i = 0; i < W; i++) {
        const size_t o = (size_t)i * (size_t)res->nsamp;
        err |= ck_io(f, res->K + o, sizeof(double), (size_t)*nfilled, writing);
        err |= ck_io(f, res->E + o, sizeof(double), (size_t)*nfilled, writing);
        err |= ck_io(f, res->rep + o, sizeof(int), (size_t)*nfilled, writing);
    }
    return err ? -1 : 0;
}

static int ck_write(const char *path, const REUSParams *p, REUSResult *res, Replica *rep,
                    int *rep_of_win, Rng *master, long c_next, long nfilled)
{
    char tmp[1100];
    CkHeader h;
    FILE *f;
    int err;
    ck_header(p, res->nsamp, &h);
    snprintf(tmp, sizeof(tmp), "%s.tmp", path);
    f = fopen(tmp, "wb");
    if (!f) {
        fprintf(stderr, "error: cannot write checkpoint %s\n", tmp);
        return -1;
    }
    err = ck_io(f, &h, sizeof(h), 1, 1);
    if (!err) err = ck_body(f, 1, &h, res, rep, rep_of_win, master, &c_next, &nfilled);
    if (fclose(f) != 0) err = -1;
    if (err) {
        remove(tmp);
        fprintf(stderr, "error: writing checkpoint %s failed\n", tmp);
        return -1;
    }
#ifdef _WIN32
    remove(path); /* rename does not replace an existing file on Windows */
#endif
    if (rename(tmp, path) != 0) {
        fprintf(stderr, "error: cannot rename %s to %s\n", tmp, path);
        return -1;
    }
    return 0;
}

static int ck_read(const char *path, const REUSParams *p, REUSResult *res, Replica *rep,
                   int *rep_of_win, Rng *master, long *c_next)
{
    CkHeader want, got;
    FILE *f = fopen(path, "rb");
    long nfilled = 0;
    int err;
    if (!f) {
        fprintf(stderr, "error: cannot open checkpoint %s\n", path);
        return -1;
    }
    ck_header(p, res->nsamp, &want);
    memset(&got, 0, sizeof(got));
    err = ck_io(f, &got, sizeof(got), 1, 0);
    if (err || memcmp(got.magic, want.magic, 8) != 0) {
        fprintf(stderr, "error: %s is not a REUS checkpoint of this version\n", path);
        fclose(f);
        return -1;
    }
    if (got.L != want.L || got.tobs != want.tobs || got.nwin != want.nwin ||
        got.swap_every != want.swap_every || got.sample_every != want.sample_every ||
        got.T != want.T || got.eps != want.eps || got.s != want.s || got.g != want.g ||
        got.k_lo != want.k_lo || got.k_hi != want.k_hi || got.n_equil != want.n_equil ||
        got.n_prod != want.n_prod || got.nsamp != want.nsamp) {
        fprintf(stderr,
                "error: checkpoint %s was written with different parameters\n"
                "  checkpoint: L %d T %g eps %g s %g g %g tobs %d nwin %d k [%g, %g] "
                "n_equil %ld n_prod %ld swap_every %d sample_every %d\n"
                "  this run  : L %d T %g eps %g s %g g %g tobs %d nwin %d k [%g, %g] "
                "n_equil %ld n_prod %ld swap_every %d sample_every %d\n"
                "  (remove the checkpoint to start over)\n",
                path, got.L, got.T, got.eps, got.s, got.g, got.tobs, got.nwin, got.k_lo,
                got.k_hi, got.n_equil, got.n_prod, got.swap_every, got.sample_every, want.L,
                want.T, want.eps, want.s, want.g, want.tobs, want.nwin, want.k_lo, want.k_hi,
                want.n_equil, want.n_prod, want.swap_every, want.sample_every);
        fclose(f);
        return -1;
    }
    err = ck_body(f, 0, &got, res, rep, rep_of_win, master, c_next, &nfilled);
    fclose(f);
    if (err) {
        fprintf(stderr, "error: checkpoint %s is truncated or damaged\n", path);
#!/usr/bin/env bash
# Replica-exchange umbrella sampling (east_reus) in K at fixed (eps, g, L,
# tobs, s), followed by MBAR and the equal-weight point.
# Windows: [KMIN_ALL + i*D, KMIN_ALL + (i+2)*D], D = (KMAX_ALL-KMIN_ALL)/(NWIN+1).
#
# Run from the project root:
#   bash scripts/run_reus.sh          # REUS run (or resume), then MBAR
#   bash scripts/run_reus.sh mbar     # MBAR only (after a finished run)
#   bash scripts/run_reus.sh params   # print the parameters as KEY=VALUE lines
#
# Every parameter below can be overridden from the environment, e.g.
#   EPS=0.003 G=0.05 bash scripts/run_reus.sh
# On a SLURM cluster submit with scripts/submit_reus.sh instead.
#
# Checkpoints: the REUS state is saved in <dir>/reus.ckpt every
# CHECKPOINT_EVERY seconds and when the run stops early (STOP_AFTER seconds,
# SIGTERM or SIGUSR1). Running the same command again resumes from it. Exit
# status 3 means "stopped with a checkpoint, run again". A finished run leaves
# <dir>/reus.done (its parameters); a later run with the same parameters skips
# REUS and only redoes MBAR, one with different parameters stops with an error.
#
# Parallel windows: build with "make OMP=1" and set OMP_NUM_THREADS, e.g.
#   OMP_NUM_THREADS=4 bash scripts/run_reus.sh
set -euo pipefail

# ---- parameters (defaults; environment variables of the same name win) -----
EPS=${EPS:-0.01}
G=${G:-0.0}
L=${L:-100}
TOBS=${TOBS:-600}
S=${S:-0.018}                       # s of the runs; near the expected s* (not critical)
KMIN_ALL=${KMIN_ALL:-0.0}           # k range covered by the windows: must contain both peaks
KMAX_ALL=${KMAX_ALL:-0.11}
NWIN=${NWIN:-30}
# starting trajectories: empty, equilibrium, or a file pattern with %02d for the
# window index (missing files start empty), e.g. the .traj files of an earlier
# umbrella run: INIT="umb/eps0.01_g+0.000/L100_t600_s+0.0250/w%02d.traj"
INIT=${INIT:-empty}
T=${T:-1}
N_APPROACH=${N_APPROACH:-1000000}   # maximum moves for a replica to enter its window, per attempt
N_EQUIL=${N_EQUIL:-20000}           # moves per window before sampling (with swaps)
N_PROD=${N_PROD:-1000000}           # sampled moves per window
SWAP_EVERY=${SWAP_EVERY:-10}        # moves between swap attempts
EVERY=${EVERY:-10}                  # moves between samples (multiple of SWAP_EVERY)
PROGRESS=${PROGRESS:-10000}         # progress report every this many cycles (0: off)
CHECKPOINT_EVERY=${CHECKPOINT_EVERY:-1800}  # seconds of wall time between checkpoints
STOP_AFTER=${STOP_AFTER:-0}         # stop with a checkpoint after this many seconds (0: never)
# MBAR / analysis
S_TARGET=${S_TARGET:-0.010:0.00025:0.035}   # reweighting grid in s (also the s* search range)
KCUT=${KCUT:-auto}                  # auto, a value of k, or none
HIST_S=${HIST_S:-0.015,0.0175,0.020}        # s values for reweighted P(k) output
HIST_BINS=${HIST_BINS:-60}
SMOOTH_RES=${SMOOTH_RES:-30}        # smoothing resolution m: window ~ 1/m of the k range
N_BOOT=${N_BOOT:-30}
BLOCK=${BLOCK:-100}
OUT_ROOT=${OUT_ROOT:-reus}
# ---------------------------------------------------------------------------
PARAM_NAMES="EPS G L TOBS S KMIN_ALL KMAX_ALL NWIN INIT T N_APPROACH N_EQUIL N_PROD SWAP_EVERY
EVERY PROGRESS CHECKPOINT_EVERY STOP_AFTER S_TARGET KCUT HIST_S HIST_BINS SMOOTH_RES N_BOOT BLOCK
OUT_ROOT"

DIR=$(printf "%s/eps%s_g%+.3f/L%d_t%d_s%+.4f" "$OUT_ROOT" "$EPS" "$G" "$L" "$TOBS" "$S")

reus_params() { # the parameters that define the REUS samples
    cat <<EOT
L             $L
T             $T
eps           $EPS
s             $S
g             $G
tobs          $TOBS
nwin          $NWIN
k_lo          $KMIN_ALL
k_hi          $KMAX_ALL
init          $INIT
n_approach    $N_APPROACH
n_equil       $N_EQUIL
n_prod        $N_PROD
swap_every    $SWAP_EVERY
sample_every  $EVERY
EOT
}

run_reus() {
    local rc=0
    mkdir -p "$DIR"
    if [ -f "$DIR/reus.done" ]; then
        if reus_params | cmp -s - "$DIR/reus.done"; then
            echo "[$(date '+%F %T')] REUS already finished in $DIR; skipping to MBAR"
            return 0
        fi
        echo "error: $DIR holds a finished REUS run with other parameters (see $DIR/reus.done);" >&2
        echo "       set OUT_ROOT to another folder, or remove $DIR/reus.done to run again" >&2
        exit 1
    fi
    {
        reus_params
        echo "seed          0"
        echo "progress      $PROGRESS"
        echo "checkpoint    $DIR/reus.ckpt"
        echo "checkpoint_every $CHECKPOINT_EVERY"
        echo "stop_after    $STOP_AFTER"
        echo "output_prefix $DIR/"
    } > "$DIR/reus.inp"
    if [ -f "$DIR/reus.ckpt" ]; then
        echo "[$(date '+%F %T')] REUS resume from checkpoint: $DIR"
    else
        echo "[$(date '+%F %T')] REUS start: $DIR"
    fi
    ./bin/east_reus "$DIR/reus.inp" >> "$DIR/reus.log" || rc=$?
    if [ "$rc" -eq 3 ]; then
        echo "[$(date '+%F %T')] REUS stopped with a checkpoint; run the same command again to resume"
        exit 3
    elif [ "$rc" -ne 0 ]; then
        echo "[$(date '+%F %T')] REUS failed (exit status $rc)" >&2
        exit "$rc"
    fi
    reus_params > "$DIR/reus.done"
    echo "[$(date '+%F %T')] REUS done: summary in $DIR/summary.dat"
}

run_mbar() {
    local i
    {
        for ((i = 0; i < NWIN; i++)); do echo "window $DIR/$(printf "w%02d" "$i").dat"; done
        echo "target_s    $S_TARGET"
        echo "target_g    $G"
        if [ "$KCUT" != "none" ]; then echo "kcut        $KCUT"; fi
        echo "hist_s      $HIST_S"
        echo "hist_bins   $HIST_BINS"
        echo "smooth_res  $SMOOTH_RES"
        echo "hist_output $DIR/mbar_hist.dat"
        echo "n_boot      $N_BOOT"
        echo "block       $BLOCK"
        echo "seed        1"
        echo "output      $DIR/mbar.dat"
    } > "$DIR/mbar.inp"
    ./bin/east_mbar "$DIR/mbar.inp"
    echo "[$(date '+%F %T')] MBAR done: $DIR/mbar.dat, $DIR/mbar_hist.dat"
    grep -E "s_equal|^# peaks " "$DIR/mbar.dat" || true
}

case "${1:-all}" in
    all)
        run_reus
        run_mbar
        ;;
    mbar)
        run_mbar
        ;;
    params)
        for k in $PARAM_NAMES; do printf '%s=%q\n' "$k" "${!k}"; done
        echo "# output folder: $DIR"
        ;;
    *)
        echo "usage: bash scripts/run_reus.sh [all | mbar | params]" >&2
        exit 1
        ;;
esac

