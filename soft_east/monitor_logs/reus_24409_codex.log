                int j, best = -1;
                long bgap = 0;
                src[i] = -1;
                if (in[i]) continue;
                for (j = 0; j < W; j++) {
                    long gap;
                    if (!in[j]) continue;
                    gap = window_gap(rep[j].tr.K, res->Kmin[i], res->Kmax[i]);
