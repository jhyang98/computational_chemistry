            fail = 1;
            goto done;
        }
        ws[i] = p->s;
        wg[i] = p->g;
        res->seeded_from[i] = -1;
        rng_seed(&rep[i].rng, res->seed_used + 0x9E3779B97F4A7C15ULL * (uint64_t)(i + 1));
        rep[i].win = i;
        rep[i].trip = 0;
        rep_of_win[i] = i;
