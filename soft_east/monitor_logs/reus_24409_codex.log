#!/usr/bin/env bash
# Submit scripts/run_reus.sh as a SLURM job (batch script: scripts/slurm_reus.sh).
#
# Run from the project root:
#   bash scripts/submit_reus.sh                            # defaults of run_reus.sh
#   bash scripts/submit_reus.sh EPS=0.003 G=0.05 TOBS=400  # override parameters for this job
#   bash scripts/submit_reus.sh MODE=mbar EPS=0.003        # MBAR only (REUS already finished)
#   bash scripts/submit_reus.sh --dry-run EPS=0.003        # show the job, do not submit
#   bash scripts/submit_reus.sh --from slurm_jobs/<file>.env  # same parameters as that job
#                                                          # (e.g. to continue it after
#                                                          # MAX_REQUEUE was reached)
#
# KEY=VALUE pairs set parameters of scripts/run_reus.sh for this job only. All
# parameters are frozen at submission in slurm_jobs/<file>.env, so editing
# run_reus.sh later does not change jobs that are already queued. Every
# submission is listed in slurm_jobs/jobs.txt.
set -euo pipefail

# ---- cluster settings --------------------------------------------------------
NODE="node3"        # SLURM name of compute node 3
PARTITION=""        # partition (empty: the cluster default)
CPUS=4              # cores per job = OpenMP threads
TIME=24:00:00       # requested limit; capped at the SLURM partition maximum
JOB_NAME=soft_east  # jobs with this name run one at a time (--dependency=singleton),
                    # so at most CPUS cores are in use at once
MAX_REQUEUE=10      # automatic requeues allowed per job
MARGIN=1800         # REUS checkpoints and stops this many seconds before the limit
SIGNAL_LEAD=600     # SIGUSR1 to the batch script this many seconds before the limit
LOG_DIR=slurm_logs
JOB_DIR=slurm_jobs
# ------------------------------------------------------------------------------

to_seconds() { # D-HH:MM:SS, HH:MM:SS, or MM:SS -> seconds
    local t=$1 d=0 h=0 m=0 s=0
    local -a fields
    if [[ $t == *-* ]]; then
        d=${t%%-*}
        t=${t#*-}
    fi
    IFS=: read -r -a fields <<< "$t"
    case ${#fields[@]} in
        3) h=${fields[0]}; m=${fields[1]}; s=${fields[2]} ;;
        2) m=${fields[0]}; s=${fields[1]} ;;
        *) return 1 ;;
    esac
    [[ $d =~ ^[0-9]+$ && ${h:-x} =~ ^[0-9]+$ && ${m:-x} =~ ^[0-9]+$ && ${s:-x} =~ ^[0-9]+$ ]] ||
        return 1
    echo $(((((10#$d * 24) + 10#$h) * 60 + 10#$m) * 60 + 10#$s))
}

to_slurm_time() { # seconds -> D-HH:MM:SS or HH:MM:SS
    local total=$1 d h m s
    d=$((total / 86400))
    total=$((total % 86400))
    h=$((total / 3600))
    total=$((total % 3600))
    m=$((total / 60))
    s=$((total % 60))
    if [ "$d" -gt 0 ]; then
        printf '%d-%02d:%02d:%02d\n' "$d" "$h" "$m" "$s"
    else
        printf '%02d:%02d:%02d\n' "$h" "$m" "$s"
    fi
}

partition_limit() {
    local row
    if [ -n "$PARTITION" ]; then
        row=$(sinfo -h -p "$PARTITION" -o '%P|%l' |
            awk -F'|' 'NF >= 2 {gsub(/[[:space:]]/, "", $1); gsub(/[[:space:]]/, "", $2); print $1 "|" $2; exit}')
    else
        row=$(sinfo -h -o '%P|%l' |
            awk -F'|' '$1 ~ /\*/ {gsub(/[[:space:]*]/, "", $1); gsub(/[[:space:]]/, "", $2); print $1 "|" $2; exit}')
    fi
    [ -n "$row" ] || return 1
    printf '%s\n' "$row"
}

dry=0
mode=""
overrides=()
known=" $(bash scripts/run_reus.sh params | grep -v '^#' | cut -d= -f1 | tr '\n' ' ') "
if [ "${1:-}" = "--from" ]; then
    if [ $# -lt 2 ] || [ ! -f "$2" ]; then
        echo "error: --from needs an existing parameter file (slurm_jobs/*.env)" >&2
        exit 1
    fi
    keep_max=$MAX_REQUEUE
    set -a
    # shellcheck disable=SC1090
    . "$2"
    set +a
    mode=${MODE:-}
    unset STOP_AFTER MODE
    MAX_REQUEUE=$keep_max # the cluster setting above, not the one in the file
    shift 2
fi
for a in "$@"; do
    case "$a" in
        --dry-run) dry=1 ;;
        MODE=*) mode=${a#MODE=} ;;
        *=*)
            k=${a%%=*}
            if [[ $known != *" $k "* || $k == STOP_AFTER ]]; then
                echo "error: unknown parameter '$k' (see: bash scripts/run_reus.sh params)" >&2
                exit 1
            fi
            overrides+=("$a")
            ;;
        *)
            echo "usage: bash scripts/submit_reus.sh [--from FILE.env] [--dry-run] [MODE=all|mbar]" \
                "[KEY=VALUE ...]" >&2
            exit 1
            ;;
    esac
done
mode=${mode:-all}
if [[ $mode != all && $mode != mbar ]]; then
    echo "error: MODE must be all or mbar" >&2
    exit 1
fi
if [ -z "$NODE" ]; then
    echo "error: set NODE at the top of scripts/submit_reus.sh to the SLURM name of compute" >&2
    echo "       node 3 (list the nodes with: sinfo -N -l)" >&2
    exit 1
fi
if ! requested_limit=$(to_seconds "$TIME"); then
    echo "error: TIME must look like 24:00:00 or 1-00:00:00" >&2
    exit 1
fi
if ! partition_info=$(partition_limit); then
    if [ -n "$PARTITION" ]; then
        echo "error: cannot read the SLURM time limit for partition '$PARTITION'" >&2
    else
        echo "error: cannot find the default SLURM partition and its time limit" >&2
        echo "       set PARTITION at the top of scripts/submit_reus.sh" >&2
    fi
    exit 1
fi
job_partition=${partition_info%%|*}
server_time=${partition_info#*|}
limit=$requested_limit
effective_time=$TIME
case ${server_time^^} in
    INFINITE|UNLIMITED)
        ;;
    *)
        if ! server_limit=$(to_seconds "$server_time"); then
            echo "error: unsupported SLURM time limit '$server_time' for partition '$job_partition'" >&2
            exit 1
        fi
        if [ "$server_limit" -lt "$limit" ]; then
            limit=$server_limit
            effective_time=$(to_slurm_time "$limit")
        fi
        ;;
esac
if [ "$limit" -lt 120 ]; then
    echo "error: effective SLURM time limit must be at least 120 seconds" >&2
    exit 1
fi
effective_margin=$MARGIN
max_margin=$((limit / 4))
if [ "$effective_margin" -gt "$max_margin" ]; then effective_margin=$max_margin; fi
effective_signal_lead=$SIGNAL_LEAD
max_signal_lead=$((effective_margin / 2))
if [ "$effective_signal_lead" -gt "$max_signal_lead" ]; then
    effective_signal_lead=$max_signal_lead
fi
stop_after=$((limit - effective_margin))
if [ "$stop_after" -le 0 ] || [ "$effective_signal_lead" -le 0 ] ||
   [ "$effective_signal_lead" -ge "$effective_margin" ]; then
    echo "error: cannot fit checkpoint and signal margins inside effective time $effective_time" >&2
    exit 1
fi
[ -x bin/east_reus ] && [ -x bin/east_mbar ] || {
    echo "error: build first (make OMP=1)" >&2
    exit 1
}

mkdir -p "$LOG_DIR" "$JOB_DIR"
envfile="$JOB_DIR/${JOB_NAME}_$(date +%Y%m%d_%H%M%S)_$$.env"
{
    env ${overrides[@]+"${overrides[@]}"} STOP_AFTER="$stop_after" bash scripts/run_reus.sh params |
        grep -v '^#'
    printf 'MODE=%q\n' "$mode"
    printf 'MAX_REQUEUE=%q\n' "$MAX_REQUEUE"
} > "$envfile"
outdir=$(env ${overrides[@]+"${overrides[@]}"} bash scripts/run_reus.sh params | sed -n 's/^# output folder: //p')

args=(--job-name="$JOB_NAME" --nodes=1 --ntasks=1 --cpus-per-task="$CPUS" --time="$effective_time"
      --nodelist="$NODE" --requeue --dependency=singleton --open-mode=append
      --signal=B:USR1@"$effective_signal_lead" --output="$LOG_DIR/%x_%j.out"
      --export=ALL,JOB_ENV="$envfile")
if [ -n "$PARTITION" ]; then args+=(--partition="$PARTITION"); fi

echo "parameters : $envfile"
echo "output     : $outdir"
echo "partition  : $job_partition (maximum $server_time)"
echo "mode       : $mode, $CPUS cores on $NODE, time limit $effective_time, REUS stops after ${stop_after} s"
echo "command    : sbatch ${args[*]} scripts/slurm_reus.sh"
if [ "$dry" -eq 1 ]; then
    echo "(dry run: not submitted)"
    rm -f "$envfile"
    exit 0
fi
jobid=$(sbatch --parsable "${args[@]}" scripts/slurm_reus.sh)
jobid=${jobid%%;*}
printf '%s  %s  %s  %s  %s\n' "$jobid" "$(date '+%F %T')" "$mode" "$outdir" "$envfile" \
    >> "$JOB_DIR/jobs.txt"
echo "submitted  : job $jobid (log: $LOG_DIR/${JOB_NAME}_$jobid.out)"
#!/usr/bin/env bash
# SLURM batch script that runs scripts/run_reus.sh. Submit it with
# scripts/submit_reus.sh, which sets the node, cores and time limit and
# freezes the parameters in the file named by JOB_ENV.
#
# Time limit: REUS stops by itself STOP_AFTER seconds into the run and leaves
# a checkpoint (run_reus.sh exits with status 3); this script then requeues
# the job and the next run resumes from the checkpoint. If the run is still
# busy when SLURM sends SIGUSR1 shortly before the limit (for example in
# MBAR), east_reus is asked to write its checkpoint and the job is requeued.
# A requeued job keeps its job ID and appends to the same log file.
set -uo pipefail
cd "${SLURM_SUBMIT_DIR:-.}" || exit 1
if [ -z "${JOB_ENV:-}" ] || [ ! -f "$JOB_ENV" ]; then
    echo "error: JOB_ENV is unset or missing; submit with scripts/submit_reus.sh" >&2
    exit 1
fi
set -a
# shellcheck disable=SC1090
. "$JOB_ENV"
set +a
MODE=${MODE:-all}
MAX_REQUEUE=${MAX_REQUEUE:-10}
export OMP_NUM_THREADS=${SLURM_CPUS_PER_TASK:-1}

stamp() { date '+%F %T'; }

requeue() {
    local n=${SLURM_RESTART_COUNT:-0}
    if [ -z "${SLURM_JOB_ID:-}" ]; then
        echo "[$(stamp)] not under SLURM: run again to resume"
        exit 3
    fi
    if [ "$n" -ge "$MAX_REQUEUE" ]; then
        echo "[$(stamp)] not requeued: already requeued $n times (MAX_REQUEUE = $MAX_REQUEUE)"
        exit 1
    fi
    echo "[$(stamp)] requeue job $SLURM_JOB_ID (restart $((n + 1)) of at most $MAX_REQUEUE)"
    if ! scontrol requeue "$SLURM_JOB_ID"; then
        echo "[$(stamp)] error: scontrol requeue failed" >&2
        exit 1
    fi
    exit 0
}

on_usr1() {
    echo "[$(stamp)] time limit near"
    # east_reus writes a checkpoint and stops at the next cycle on SIGTERM
    if pkill -TERM -P "$RUN_PID" -x east_reus 2> /dev/null; then
        for _ in $(seq 1 180); do
            pgrep -P "$RUN_PID" -x east_reus > /dev/null || break
            sleep 1
        done
    fi
    requeue
}
trap on_usr1 USR1

echo "[$(stamp)] job ${SLURM_JOB_ID:-local} on $(hostname), restart ${SLURM_RESTART_COUNT:-0}," \
    "$OMP_NUM_THREADS threads, mode $MODE, parameters $JOB_ENV"
bash scripts/run_reus.sh "$MODE" &
RUN_PID=$!
wait "$RUN_PID"
rc=$?
if [ "$rc" -eq 3 ]; then requeue; fi
echo "[$(stamp)] finished with exit status $rc"
exit "$rc"
#!/usr/bin/env bash
# Monitor one REUS SLURM job and invoke Codex only on a health event or completion.
set -euo pipefail

if [ $# -ne 2 ]; then
    echo "usage: bash scripts/monitor_reus_codex.sh JOB_ID JOB_ENV" >&2
    exit 1
fi

JOB_ID=$1
JOB_ENV=$2
POLL_SECONDS=${POLL_SECONDS:-300}
STALE_SECONDS=${STALE_SECONDS:-5400}
CODEX_RETRIES=${CODEX_RETRIES:-3}
SYNC_RETRIES=${SYNC_RETRIES:-5}
LOG_DIR=monitor_logs

cd "$(dirname "$0")/.."
mkdir -p "$LOG_DIR"
MONITOR_LOG="$LOG_DIR/reus_${JOB_ID}.log"
CODEX_LOG="$LOG_DIR/reus_${JOB_ID}_codex.log"

stamp() { date '+%F %T'; }

record() {
    printf '[%s] %s\n' "$(stamp)" "$*" | tee -a "$MONITOR_LOG"
}

job_line() {
    squeue -h -j "$JOB_ID" -o '%T|%M|%R' 2>/dev/null || return 2
}

output_dir() {
    awk -v id="$JOB_ID" '$1 == id { print $5; exit }' slurm_jobs/jobs.txt
}

run_codex() {
    local purpose=$1 prompt=$2 attempt rc=1
    for ((attempt = 1; attempt <= CODEX_RETRIES; attempt++)); do
        record "starting Codex $purpose attempt $attempt of $CODEX_RETRIES"
        if codex exec -C . --skip-git-repo-check --approve-for-me \
            --add-dir /tmp \
            -o "$LOG_DIR/reus_${JOB_ID}_${purpose}_last.txt" "$prompt" \
            >> "$CODEX_LOG" 2>&1; then
            record "Codex $purpose completed"
            return 0
        else
            rc=$?
        fi
        record "Codex $purpose failed with status $rc"
        sleep 60
    done
    return "$rc"
}

continue_after_requeue_limit() {
    local submit_output new_job new_env
    record "automatic requeue limit reached; submitting from the saved parameters"
    submit_output=$(bash scripts/submit_reus.sh --from "$JOB_ENV" 2>&1) || {
        printf '%s\n' "$submit_output" >> "$MONITOR_LOG"
        return 1
    }
    printf '%s\n' "$submit_output" >> "$MONITOR_LOG"
    new_job=$(printf '%s\n' "$submit_output" | sed -n 's/^submitted  : job \([0-9][0-9]*\).*/\1/p')
    new_env=$(printf '%s\n' "$submit_output" | sed -n 's/^parameters : //p')
    if [ -z "$new_job" ] || [ -z "$new_env" ]; then
        record "could not parse the continuation submission"
        return 1
    fi
    JOB_ID=$new_job
    JOB_ENV=$new_env
    MONITOR_LOG="$LOG_DIR/reus_${JOB_ID}.log"
    CODEX_LOG="$LOG_DIR/reus_${JOB_ID}_codex.log"
    record "monitoring continuation job $JOB_ID"
}

find_replacement_job() {
    local out=$1 line new_job new_env
    line=$(awk -v out="$out" '$5 == out { line=$0 } END { print line }' slurm_jobs/jobs.txt)
    new_job=$(printf '%s\n' "$line" | awk '{ print $1 }')
    new_env=$(printf '%s\n' "$line" | awk '{ print $6 }')
    if [ -n "$new_job" ] && [ "$new_job" != "$JOB_ID" ] && [ -n "$new_env" ]; then
        JOB_ID=$new_job
        JOB_ENV=$new_env
        MONITOR_LOG="$LOG_DIR/reus_${JOB_ID}.log"
        CODEX_LOG="$LOG_DIR/reus_${JOB_ID}_codex.log"
        record "Codex submitted replacement job $JOB_ID"
        return 0
    fi
    return 1
}

finalize_job() {
    local out=$1 prompt attempt
    prompt=$(cat <<EOF
Work autonomously on completed soft_east SLURM job $JOB_ID.
Read AGENTS.md, STATUS.md, and README.md first. The frozen parameter file is $JOB_ENV,
the scheduler log is slurm_logs/soft_east_${JOB_ID}.out, and the result directory is $out.
Follow the completed-run checklist in STATUS.md exactly. Validate summary.dat, mbar.dat,
and mbar_hist.dat; rerun only the same-parameter MBAR analysis if needed. Read the frozen
parameters to identify the campaign condition and compare it with the scientifically relevant
completed runs. Interpret whether P(k) has one or two peaks. At the chi_KK maximum, report
chi_KK, its s location, the width of P(k), and Binder U when the available samples or histogram
support it. Also report s_equal, delta k, delta e, round trips, worst swap acceptance, worst KS,
minimum N_eff, elapsed time, requeue behavior, and any caveat. Update STATUS.md and README.md
in Korean with stable results and next-step implications. Do not submit a new scientific
condition. Do not perform any Git operation; the monitor synchronizes GitHub after you finish.
Keep code, comments, and command output in English.
EOF
)
    run_codex finalize "$prompt" || return 1
    for ((attempt = 1; attempt <= SYNC_RETRIES; attempt++)); do
        record "starting GitHub sync attempt $attempt of $SYNC_RETRIES"
        if bash scripts/sync_github_soft_east.sh "Complete REUS job $JOB_ID analysis" \
            >> "$MONITOR_LOG" 2>&1; then
            record "GitHub sync completed"
            touch "$LOG_DIR/reus_${JOB_ID}.finalized"
            return 0
        fi
        record "GitHub sync attempt $attempt failed"
        sleep 120
    done
    return 1
}

diagnose_job() {
    local out=$1 reason=$2 prompt
    prompt=$(cat <<EOF
Diagnose soft_east SLURM job $JOB_ID autonomously because the monitor observed: $reason.
Read AGENTS.md, STATUS.md, and README.md first. Inspect $JOB_ENV,
slurm_logs/soft_east_${JOB_ID}.out, squeue/scontrol, and $out. Follow the documented recovery
rules. You may resume the same frozen parameters, rerun same-parameter MBAR, fix a clear
implementation or operational error, and submit a documented recoverable continuation without
asking. Never change the scientific parameters or delete results. If a new scientific decision
is required, stop without submitting it and record the blocking reason in STATUS.md. If you
submit a replacement job, use bash scripts/submit_reus.sh and keep the same output directory.
Do not perform any Git operation; the monitor handles synchronization after final completion.
Keep code, comments, and command output in English.
EOF
)
    run_codex diagnose "$prompt"
}

if [ ! -f "$JOB_ENV" ]; then
    echo "error: parameter file not found: $JOB_ENV" >&2
    exit 1
fi

OUT_DIR=$(output_dir)
if [ -z "$OUT_DIR" ]; then
    echo "error: job $JOB_ID is not listed in slurm_jobs/jobs.txt" >&2
    exit 1
fi

record "monitor started for job $JOB_ID, output $OUT_DIR"
missing_checks=0
stale_marker=0

while :; do
    state=$(job_line) || {
        record "squeue query failed; retrying"
        sleep "$POLL_SECONDS"
        continue
    }
    log_file="slurm_logs/soft_east_${JOB_ID}.out"
    if [ -n "$state" ]; then
        missing_checks=0
        if [ -f "$log_file" ]; then
            now=$(date +%s)
            modified=$(stat -c %Y "$log_file")
            if [ $((now - modified)) -ge "$STALE_SECONDS" ] && [ "$modified" -ne "$stale_marker" ]; then
                stale_marker=$modified
                record "job is active but its log is stale: $state"
                diagnose_job "$OUT_DIR" "the active job log has not changed for at least $STALE_SECONDS seconds" || true
                find_replacement_job "$OUT_DIR" || true
            fi
        fi
        sleep "$POLL_SECONDS"
        continue
    fi

    missing_checks=$((missing_checks + 1))
    if [ "$missing_checks" -lt 4 ]; then
        sleep 60
        continue
    fi

    if [ -f "$log_file" ] && grep -q 'not requeued: already requeued' "$log_file"; then
        continue_after_requeue_limit || {
            diagnose_job "$OUT_DIR" "the automatic requeue limit was reached and continuation submission failed" || true
            find_replacement_job "$OUT_DIR" || exit 1
        }
        missing_checks=0
        continue
    fi

    if [ -f "$log_file" ] && grep -q 'finished with exit status 0' "$log_file" && \
       [ -f "$OUT_DIR/reus.done" ] && [ -f "$OUT_DIR/mbar.dat" ]; then
        record "job completed successfully"
        if ! finalize_job "$OUT_DIR"; then
            record "finalization failed; manual intervention required"
            exit 1
        fi
        record "monitor finished"
        exit 0
    fi

    diagnose_job "$OUT_DIR" "the job left the queue without a verified successful result" || true
    if find_replacement_job "$OUT_DIR"; then
        missing_checks=0
        continue
    fi
    record "no recoverable replacement job was found"
    exit 1
done

