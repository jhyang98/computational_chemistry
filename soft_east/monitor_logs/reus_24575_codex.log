/*
 * Replica-exchange umbrella sampling (REUS) in the activity K.
 *
 * nwin umbrella windows at the same (s, g): window w restricts K to
 *   [ceil(k_lo + w D) L tobs, floor(k_lo + (w+2) D) L tobs],
 *   D = (k_hi - k_lo) / (nwin + 1),
 * so neighbouring windows overlap by half a window. One replica (trajectory)
 * sits in each window. A cycle is swap_every shooting moves per replica
 * (tps_shoot, run in parallel with OpenMP if enabled), followed by swap
 * attempts between neighbouring windows (even pairs on even cycles, odd pairs
 * on odd cycles). A swap of replicas a (in w) and b (in w+1) is accepted with
 *   min(1, exp(u_w(a) + u_{w+1}(b) - u_w(b) - u_{w+1}(a))),
 * u_w(x) = s K + g E inside window w and +inf outside; with equal s and g
 * this means: accepted whenever each trajectory lies in the other's window.
 *
 * Each replica first enters its starting window (approach phase of
 * tps_shoot, at most n_approach moves). A replica that does not get there
 * restarts from a copy of the trajectory of a replica that did, the one whose
 * K is closest to the nearest missing frontier, and approaches again; this is
 * repeated until every window is reached or three rounds in a row bring no
 * new window in. Then n_equil moves
 * with swaps, then n_prod moves with swaps while the (K, E) of the replica in
 * each window is recorded every sample_every moves.
 *
 * Checkpoints (optional): with a checkpoint file set, the full state
 * (trajectories, random-number states, window assignment, counters and the
 * samples so far) is written during and after the approach phase, every
 * checkpoint_every seconds of wall time, and when the run is asked to stop
 * (stop_after seconds elapsed, or SIGTERM / SIGUSR1). reus_run then returns
 * REUS_STOPPED; called again with the same parameters it resumes from the
 * file and gives exactly the same result as an uninterrupted run. The file
 * is written to <file>.tmp first and then renamed.
 */
#ifndef REUS_H
#define REUS_H

#include <stdint.h>

#include "dyn.h"

typedef struct {
    int L;
    double T, eps, s, g;
    int tobs;
    uint64_t seed;     /* 0: from the clock */
    int nwin;
    double k_lo, k_hi; /* k range covered by the windows */
    long n_approach;   /* maximum moves per replica to enter its window */
    long n_equil;      /* moves per replica before sampling */
    long n_prod;       /* moves per replica while sampling */
    int swap_every;    /* moves between swap attempts */
    int sample_every;  /* moves between samples (multiple of swap_every) */
    const char *init;  /* "empty", "equilibrium", or a file pattern with one %d
                          (window index); a missing file falls back to empty */
    long progress;     /* report every this many cycles (0: never) */
    const char *checkpoint;  /* checkpoint file (NULL or "": none) */
    double checkpoint_every; /* seconds of wall time between checkpoints (0: only on stop) */
    double stop_after;       /* write a checkpoint and stop after this many seconds (0: never) */
    long stop_approach_round; /* testing: stop after this many approach retry rounds (0: never) */
    long stop_cycle;         /* testing: checkpoint and stop once this many cycles are done (0: never) */
} REUSParams;

#define REUS_STOPPED 3 /* reus_run: stopped after writing a checkpoint, not finished */

typedef struct {
    int nwin;
    long *Kmin, *Kmax;   /* window bounds in K */
    long nsamp;          /* samples per window */
    double *K, *E;       /* sample i of window w at [w * nsamp + i] */
    int *rep;            /* replica that produced each sample */
    long *moves, *acc;   /* shooting moves per window (production) */
    long *swap_try, *swap_acc; /* per neighbour pair (w, w+1) */
    long *round_trips;   /* per replica: window 0 -> nwin-1 -> 0 */
    long *approach;      /* per replica: moves needed to enter the window (all attempts) */
    int *init_from_file; /* per replica: 1 if started from a trajectory file */
    memcpy(dst->n, src->n, sizeof(int) * (size_t)(src->tobs + 1));
    memcpy(dst->k, src->k, sizeof(int) * (size_t)(src->tobs + 1));
    dst->K = src->K;
    dst->E = src->E;
}

static long window_gap(long K, long Kmin, long Kmax)
{
    return K < Kmin ? Kmin - K : (K > Kmax ? K - Kmax : 0);
}

/* Approach phase of tps_shoot until K is in [Kmin, Kmax]; returns the moves used. */
static long approach(Replica *r, const Dyn *d, double s, double g, long Kmin, long Kmax,
                     long nmax, time_t deadline)
{
    long m;
    int dir;
    for (m = 0; m < nmax && !stop_requested; m++) {
        if (deadline && (m & 1023L) == 0 && time(NULL) >= deadline) {
            stop_requested = 1;
            break;
        }
        if (r->tr.K >= Kmin && r->tr.K <= Kmax) break;
        tps_shoot(&r->tr, &r->sh, d, s, g, 1, Kmin, Kmax, &r->rng, &dir);
    }
    return m;
}

int reus_run(const REUSParams *p, REUSResult *res)
{
    const int W = p->nwin;
    Dyn d;
    Rng master;
    Replica *rep = NULL;
    int *rep_of_win = NULL;
    double *ws = NULL, *wg = NULL;
    long ncyc_eq, ncyc_pr, c, c0 = 0;
    int samp_cyc, i, fail = 0, stopped = 0, approach_stall = 0;
    const int ck_on = p->checkpoint && p->checkpoint[0];
    int resume = 0;
    time_t t_start = time(NULL), t_ck = t_start;
    const time_t approach_deadline =
        p->stop_after > 0.0 ? t_start + (time_t)p->stop_after : (time_t)0;

    memset(res, 0, sizeof(*res));
    if (W < 2 || p->swap_every < 1 || p->sample_every < p->swap_every ||
        p->sample_every % p->swap_every != 0 || p->n_prod < p->sample_every ||
        !(p->k_hi > p->k_lo)) {
        fprintf(stderr, "error: need nwin >= 2, k_hi > k_lo, swap_every >= 1, sample_every a "
                        "multiple of swap_every, n_prod >= sample_every\n");
        return -1;
    }
    if (dyn_init(&d, p->L, p->T, p->eps) != 0) {
        fprintf(stderr, "error: invalid L, T or eps\n");
        return -1;
    }
    res->seed_used = rng_seed_auto(&master, p->seed);
    res->nwin = W;
    ncyc_eq = p->n_equil / p->swap_every;
    ncyc_pr = p->n_prod / p->swap_every;
    samp_cyc = p->sample_every / p->swap_every;
    res->nsamp = ncyc_pr / samp_cyc;

    res->Kmin = (long *)calloc((size_t)W, sizeof(long));
    res->Kmax = (long *)calloc((size_t)W, sizeof(long));
    res->K = (double *)malloc(sizeof(double) * (size_t)W * (size_t)res->nsamp);
    res->E = (double *)malloc(sizeof(double) * (size_t)W * (size_t)res->nsamp);
    res->rep = (int *)malloc(sizeof(int) * (size_t)W * (size_t)res->nsamp);
    res->moves = (long *)calloc((size_t)W, sizeof(long));
    res->acc = (long *)calloc((size_t)W, sizeof(long));
    res->swap_try = (long *)calloc((size_t)W, sizeof(long));
    res->swap_acc = (long *)calloc((size_t)W, sizeof(long));
    res->round_trips = (long *)calloc((size_t)W, sizeof(long));
    res->approach = (long *)calloc((size_t)W, sizeof(long));
    res->init_from_file = (int *)calloc((size_t)W, sizeof(int));
    res->seeded_from = (int *)malloc(sizeof(int) * (size_t)W);
    res->final = (Traj *)calloc((size_t)W, sizeof(Traj));
    rep = (Replica *)calloc((size_t)W, sizeof(Replica));
    rep_of_win = (int *)malloc(sizeof(int) * (size_t)W);
    ws = (double *)malloc(sizeof(double) * (size_t)W);
    wg = (double *)malloc(sizeof(double) * (size_t)W);
    if (!res->Kmin || !res->Kmax || !res->K || !res->E || !res->rep || !res->moves ||
        !res->acc || !res->swap_try || !res->swap_acc || !res->round_trips || !res->approach ||
        !res->init_from_file || !res->seeded_from || !res->final || !rep || !rep_of_win || !ws ||
        !wg) {
        fprintf(stderr, "error: out of memory\n");
        fail = 1;
        goto done;
    }
    for (i = 0; i < W; i++) {
        reus_window(p, i, &res->Kmin[i], &res->Kmax[i]);
        if (res->Kmin[i] > res->Kmax[i]) {
            fprintf(stderr, "error: window %d is empty\n", i);
            fail = 1;
            goto done;
        }
        ws[i] = p->s;
        wg[i] = p->g;
        res->seeded_from[i] = -1;
        rng_seed(&rep[i].rng, res->seed_used + 0x9E3779B97F4A7C15ULL * (uint64_t)(i + 1));
        rep[i].win = i;
        rep[i].trip = 0;
        rep_of_win[i] = i;
    }
    if (ck_on) {
        FILE *t = fopen(p->checkpoint, "rb");
        resume = (t != NULL);
        if (t) fclose(t);
        stop_requested = 0;
        signal(SIGTERM, on_stop_signal);
#ifdef SIGUSR1
        signal(SIGUSR1, on_stop_signal);
#endif
    }
    for (i = 0; i < W; i++) {
        int bad = resume ? (traj_alloc(&rep[i].tr, p->L, p->tobs) != 0 ||
                            shot_alloc(&rep[i].sh, p->L, p->tobs) != 0)
                         : (init_replica(p, &d, &rep[i], i, &res->init_from_file[i]) != 0);
        if (bad) {
            fprintf(stderr, "error: cannot initialize replica %d\n", i);
            fail = 1;
            goto done;
        }
    }
    if (resume) {
        if (ck_read(p->checkpoint, p, res, rep, rep_of_win, &master, &c0) != 0) {
            fail = 1;
            goto done;
        }
        if (c0 >= 0) {
            fprintf(stderr, "east_reus: resumed from %s at cycle %ld of %ld\n", p->checkpoint,
                    c0, ncyc_eq + ncyc_pr);
            goto cycles;
        }
        if (c0 < -3) {
            fprintf(stderr, "error: checkpoint %s has an invalid approach state\n", p->checkpoint);
            fail = 1;
            goto done;
        }
        approach_stall = (int)(-c0 - 1);
        fprintf(stderr, "east_reus: resumed from %s during the approach phase\n", p->checkpoint);
    } else {
        /* approach: every replica enters its own window */
#ifdef _OPENMP
#pragma omp parallel for schedule(dynamic, 1)
#endif
        for (i = 0; i < W; i++)
            res->approach[i] =
                approach(&rep[i], &d, ws[i], wg[i], res->Kmin[i], res->Kmax[i],
                         p->n_approach, approach_deadline);
    }

    /*
     * A replica that did not reach its window restarts from a copy of the
     * trajectory of a replica that did: the one whose K is closest to the
     * nearest missing frontier (neighbouring windows overlap, so this is
     * usually inside it or close by), ties going to the nearest window index.
     * Retrying only the nearest frontier avoids spending a full approach on
     * every distant window before the intervening windows have been reached.
     * Repeated until every window is reached or three rounds in a row bring no
     * new window in.
     */
    {
        long approach_round = 0;
        int *in = (int *)malloc(sizeof(int) * (size_t)W);
        int *src = (int *)malloc(sizeof(int) * (size_t)W);
        if (!in || !src) {
            free(in);
            free(src);
            fprintf(stderr, "error: out of memory\n");
            fail = 1;
            goto done;
        }
        for (;;) {
            int nmiss = 0, nin = 0, nnew = 0;
            long nearest_gap = LONG_MAX;
            time_t now = time(NULL);
            if (ck_on && !stop_requested && p->checkpoint_every > 0.0 &&
                difftime(now, t_ck) >= p->checkpoint_every) {
                if (ck_write(p->checkpoint, p, res, rep, rep_of_win, &master,
                             -1 - approach_stall, 0) != 0) {
                    fail = 1;
                    goto done;
                }
                fprintf(stderr, "east_reus: checkpoint written during the approach phase\n");
                t_ck = now;
            }
            if (stop_requested) break;
            for (i = 0; i < W; i++) {
                in[i] = rep[i].tr.K >= res->Kmin[i] && rep[i].tr.K <= res->Kmax[i];
                nin += in[i];
                nmiss += !in[i];
            }
            if (nmiss == 0 || nin == 0) break;
            for (i = 0; i < W; i++) {
                int j, best = -1;
                long bgap = 0;
                src[i] = -1;
                if (in[i]) continue;
                for (j = 0; j < W; j++) {
                    long gap;
                    if (!in[j]) continue;
                    gap = window_gap(rep[j].tr.K, res->Kmin[i], res->Kmax[i]);
                    if (best < 0 || gap < bgap || (gap == bgap && abs(j - i) < abs(best - i))) {
                        best = j;
                        bgap = gap;
                    }
                }
                src[i] = best;
                if (bgap < nearest_gap) nearest_gap = bgap;
            }
            for (i = 0; i < W; i++) {
                int best = src[i];
                if (best < 0) continue;
                if (window_gap(rep[best].tr.K, res->Kmin[i], res->Kmax[i]) != nearest_gap) {
                    src[i] = -1;
                    continue;
                }
                fprintf(stderr,
                        "note: window %d (K %ld..%ld) not reached (K = %ld); restarting from the "
                        "trajectory of window %d (K = %ld)\n",
                        i, res->Kmin[i], res->Kmax[i], rep[i].tr.K, best, rep[best].tr.K);
                traj_copy(&rep[i].tr, &rep[best].tr);
                res->seeded_from[i] = best;
            }
#ifdef _OPENMP
#pragma omp parallel for schedule(dynamic, 1)
#endif
            for (i = 0; i < W; i++)
                if (src[i] >= 0)
                    res->approach[i] += approach(&rep[i], &d, ws[i], wg[i], res->Kmin[i],
                                                 res->Kmax[i], p->n_approach,
                                                 approach_deadline);
            for (i = 0; i < W; i++)
                if (src[i] >= 0 && rep[i].tr.K >= res->Kmin[i] && rep[i].tr.K <= res->Kmax[i])
                    nnew++;
            approach_round++;
            if (p->stop_approach_round > 0 &&
                approach_round >= p->stop_approach_round)
                stop_requested = 1;
            approach_stall = (nnew == 0) ? approach_stall + 1 : 0;
}

static int same_long(const long *a, const long *b, int n)
{
    return memcmp(a, b, sizeof(long) * (size_t)n) == 0;
}

static void test_reus_checkpoint(void)
{
    const char *ck = "east_test_reus.ckpt";
    REUSParams p;
    REUSResult a, b;
    int rc1, rc2, rc3, rc4, w, same;
    printf("\n== 12. REUS checkpoint and resume ==\n");
    remove(ck);
    reus_small_params(&p);
    if (reus_run(&p, &a) != 0) {
        check_true("uninterrupted reference run", 0);
        return;
    }
    p.checkpoint = ck;
    p.checkpoint_every = 0.0;
    p.stop_approach_round = 1;
    rc1 = reus_run(&p, &b);
    p.stop_approach_round = 0;
    rc2 = reus_run(&p, &b);
    check_true("approach phase stops with a checkpoint", rc1 == REUS_STOPPED);
    same = rc2 == 0 && a.nsamp == b.nsamp &&
           memcmp(a.K, b.K, sizeof(double) * (size_t)a.nwin * (size_t)a.nsamp) == 0 &&
           memcmp(a.E, b.E, sizeof(double) * (size_t)a.nwin * (size_t)a.nsamp) == 0 &&
           memcmp(a.rep, b.rep, sizeof(int) * (size_t)a.nwin * (size_t)a.nsamp) == 0 &&
           same_long(a.approach, b.approach, a.nwin) &&
           memcmp(a.seeded_from, b.seeded_from, sizeof(int) * (size_t)a.nwin) == 0;
    check_true("approach checkpoint resumes bit-identically", same);
    if (rc2 == 0) reus_result_free(&b);
    remove(ck);

    p.checkpoint = ck;
    p.checkpoint_every = 0.0;
    p.stop_cycle = 3; /* during equilibration (4 cycles) */
    rc1 = reus_run(&p, &b);
    p.stop_cycle = 25; /* during production */
    rc2 = reus_run(&p, &b);
    p.stop_cycle = 0;
    rc3 = reus_run(&p, &b);
    check_true("first part stops with a checkpoint (REUS_STOPPED)", rc1 == REUS_STOPPED);
    check_true("second part resumes and stops again", rc2 == REUS_STOPPED);
    check_true("third part resumes and finishes", rc3 == 0);
    if (rc3 != 0) {
        reus_result_free(&a);
        remove(ck);
        return;
    }
    same = a.nsamp == b.nsamp &&
           memcmp(a.K, b.K, sizeof(double) * (size_t)a.nwin * (size_t)a.nsamp) == 0 &&
           memcmp(a.E, b.E, sizeof(double) * (size_t)a.nwin * (size_t)a.nsamp) == 0 &&
           memcmp(a.rep, b.rep, sizeof(int) * (size_t)a.nwin * (size_t)a.nsamp) == 0;
    check_true("resumed run: samples (K, E, replica) identical", same);
    same = same_long(a.moves, b.moves, a.nwin) && same_long(a.acc, b.acc, a.nwin) &&
           same_long(a.swap_try, b.swap_try, a.nwin) && same_long(a.swap_acc, b.swap_acc, a.nwin) &&
           same_long(a.round_trips, b.round_trips, a.nwin) &&
           same_long(a.approach, b.approach, a.nwin) &&
           memcmp(a.seeded_from, b.seeded_from, sizeof(int) * (size_t)a.nwin) == 0 &&
           a.seed_used == b.seed_used;
    check_true("resumed run: counters, approach and seeding identical", same);
    same = 1;

