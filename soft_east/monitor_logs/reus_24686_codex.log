        p->sample_every % p->swap_every != 0 || p->n_prod < p->sample_every ||
        !(p->k_hi > p->k_lo)) {
        fprintf(stderr, "error: need nwin >= 2, k_hi > k_lo, swap_every >= 1, sample_every a "
                        "multiple of swap_every, n_prod >= sample_every\n");
